FROM python:3.11-slim

# Системные зависимости
RUN apt-get update && apt-get install -y \
        git \
        curl \
        unzip \
        build-essential \
        libffi-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Установка pip и инструментов анализа
RUN python3.11 -m pip install --upgrade pip \
    && python3.11 -m pip install --no-cache-dir semgrep ggshield

# Обеспечим доступ к бинарникам pip
ENV PATH="/root/.local/bin:${PATH}"

# Рабочая директория
WORKDIR /app
COPY . /app

CMD ["bash"]
